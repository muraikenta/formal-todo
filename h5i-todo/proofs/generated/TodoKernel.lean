  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let b ← title_ok title
  if b
  then
    if s.counter.next_id = core.num.U64.MAX
    then ok (core.result.Result.Err Error.Overflow)
    else
      let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 title
      let ws ←
        alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.PutTodo
          {
            id := s.counter.next_id,
            owner := user,
            title := v,
            completed := false
          })
      let i ← s.counter.next_id + 1#u64
      let ws1 ← alloc.vec.Vec.push ws (Write.SetCounter { next_id := i })
      ok (core.result.Result.Ok (ws1, Reply.Created s.counter.next_id))
  else ok (core.result.Result.Err Error.BadTitle)

/-- [todo_kernel::rename]:
    Source: 'tasks/20261127_Lean自由研究/h5i-todo/kernel/src/lib.rs', lines 129:0-142:1 -/
def rename
  (user : Std.U64) (s : Snapshot) (id : Std.U64) (title : alloc.vec.Vec Std.U8)
  :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_todo s.todos id
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some t =>
    if t.owner != user
    then ok (core.result.Result.Err Error.Forbidden)
    else
      let b ← title_ok title
      if b
      then
        let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 title
        let v1 ← one (Write.PutTodo { t with id, title := v })
        ok (core.result.Result.Ok (v1, Reply.Done))
      else ok (core.result.Result.Err Error.BadTitle)

/-- [todo_kernel::set_done]:
    Source: 'tasks/20261127_Lean自由研究/h5i-todo/kernel/src/lib.rs', lines 144:0-155:1 -/
def set_done
  (user : Std.U64) (s : Snapshot) (id : Std.U64) (completed : Bool) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_todo s.todos id
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some t =>
    if t.owner != user
    then ok (core.result.Result.Err Error.Forbidden)
    else
      let v ← one (Write.PutTodo { t with id, completed })
      ok (core.result.Result.Ok (v, Reply.Done))

/-- [todo_kernel::delete]:
    Source: 'tasks/20261127_Lean自由研究/h5i-todo/kernel/src/lib.rs', lines 157:0-168:1 -/
def delete
  (user : Std.U64) (s : Snapshot) (id : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_todo s.todos id
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some t =>
    if t.owner = user
    then
      let v ← one (Write.DelTodo id)
      ok (core.result.Result.Ok (v, Reply.Done))
    else ok (core.result.Result.Err Error.Forbidden)

/-- [todo_kernel::transition]:
    Source: 'tasks/20261127_Lean自由研究/h5i-todo/kernel/src/lib.rs', lines 172:0-180:1
    Visibility: public -/
def transition
  (actor : Principal) (s : Snapshot) (cmd : Command) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match cmd with
  | Command.Add title => add actor.user s title
  | Command.Rename id title => rename actor.user s id title
  | Command.SetDone id completed => set_done actor.user s id completed
  | Command.Delete id => delete actor.user s id
  | Command.List =>
    let v ← todos_of s.todos actor.user
    ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Todos v))

end todo_kernel
